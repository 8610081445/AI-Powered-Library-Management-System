# AI-Powered Library Management System Configuration

PORT=5000

# Database Configuration (MySQL)
# If MySQL is not reachable or credentials are blank, the system automatically runs on zero-config embedded storage!
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=library_db

# Circulation Settings
DEFAULT_LOAN_DAYS=14
DAILY_FINE_RATE=0.50
MAX_BOOKS_STUDENT=5
MAX_BOOKS_FACULTY=10

# AI Configuration (Optional)
# If left blank, the built-in offline NLP semantic intelligence engine will power all AI features!
GEMINI_API_KEY=
OPENAI_API_KEY=
